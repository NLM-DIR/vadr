# format of this file:
# '#' prefixed files are comments, and are not parsed.
# 'command:' prefix indicates remainder of line is a command to run
# 'desc:' prefix indicates description of test for dnaorg_test.pl output        
# 'out:' prefix indicates output file to check against an expected file
# 'exp:' prefix indicates expected file to check against an output file
# 'rmdir:' prefix indicates name of output directory to remove after 
# command is run and all output files have been checked.
#
# All 'out:' and 'exp:' lines following a 'command:' line (and before the 
# next 'command:' line, will be checked after that command runs. The first
# 'out:' file is compared against the first 'exp:' file, the second 
# 'out:' file is compared against the second 'exp:' file, the second 'out:'
# file, etc.
# Tests that a model info group/subgroup value with the :FILE: prefix,
# which enables nearest-neighbor (nn) classification, is never reported
# as a sequence's group or subgroup. Sequences that are not classified by
# nn (here a reverse complemented sequence, or all sequences with
# --ignore_nnclass) should have group and subgroup reported as '-'.
#
# nn classification enabled, seq6 is reverse complemented and is not nn classified
command: perl $VADRSCRIPTSDIR/v-annotate.pl -f --mdir $VADRSCRIPTSDIR/testfiles/models --mkey toy-nn $VADRSCRIPTSDIR/testfiles/toy-nn-nnclass.fa va-toy-nn-nnclass > va-toy-nn-nnclass.out
desc: annotate-toy-nn-nnclass
out: va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.sqa
out: va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.sqc
out: va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.scn
out: va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.mdl
exp: @VADRSCRIPTSDIR@/testfiles/expected-files/va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.sqa
exp: @VADRSCRIPTSDIR@/testfiles/expected-files/va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.sqc
exp: @VADRSCRIPTSDIR@/testfiles/expected-files/va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.scn
exp: @VADRSCRIPTSDIR@/testfiles/expected-files/va-toy-nn-nnclass/va-toy-nn-nnclass.vadr.mdl
rmdir: va-toy-nn-nnclass
#
# --ignore_nnclass: no sequences are nn classified
command: perl $VADRSCRIPTSDIR/v-annotate.pl -f --ignore_nnclass --mdir $VADRSCRIPTSDIR/testfiles/models --mkey toy-nn $VADRSCRIPTSDIR/testfiles/toy-nn-nnclass.fa va-toy-nn-ignore-nnclass > va-toy-nn-ignore-nnclass.out
desc: annotate-toy-nn-ignore-nnclass
out: va-toy-nn-ignore-nnclass/va-toy-nn-ignore-nnclass.vadr.sqa
out: va-toy-nn-ignore-nnclass/va-toy-nn-ignore-nnclass.vadr.sqc
out: va-toy-nn-ignore-nnclass/va-toy-nn-ignore-nnclass.vadr.mdl
exp: @VADRSCRIPTSDIR@/testfiles/expected-files/va-toy-nn-ignore-nnclass/va-toy-nn-ignore-nnclass.vadr.sqa
exp: @VADRSCRIPTSDIR@/testfiles/expected-files/va-toy-nn-ignore-nnclass/va-toy-nn-ignore-nnclass.vadr.sqc
exp: @VADRSCRIPTSDIR@/testfiles/expected-files/va-toy-nn-ignore-nnclass/va-toy-nn-ignore-nnclass.vadr.mdl
rmdir: va-toy-nn-ignore-nnclass
